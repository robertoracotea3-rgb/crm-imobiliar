# Public client configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase and account security
SUPABASE_SERVICE_ROLE_KEY=
REGISTRATION_ACCESS_CODE=
PORTAL_TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
# Minimum 16 random characters; used only to hash request IPs in the audit log.
AUDIT_IP_HASH_SALT=
# Minimum 32 random characters; hashes login identifiers/IPs and is never exposed client-side.
AUTH_SECURITY_HASH_SALT=

# E-mail operațional (server-side, recomandat: Resend)
# Adaugă mai întâi kiraimobiliare.ro în furnizor și publică exact
# înregistrările SPF/DKIM afișate de furnizor. Nu expune cheia în browser.
EMAIL_PROVIDER_API_KEY=

# Backup și recuperare (exclusiv server-side)
# Cheie base64 de 32 bytes, păstrată separat de arhive.
BACKUP_ENCRYPTION_KEY=
# Director absolut în afara proiectului, pe un volum separat și sincronizat.
BACKUP_DIRECTORY=
# Connection string PostgreSQL din Supabase > Connect; nu folosi cheia publică.
SUPABASE_DB_URL=
# Imaginea este folosită automat când pg_dump/pg_restore nu există local.
KIRA_PG_TOOLS_IMAGE=postgres:17-alpine

# Storia / OLX
STORIA_CLIENT_ID=
STORIA_CLIENT_SECRET=
STORIA_API_KEY=
STORIA_WEBHOOK_SECRET=
STORIA_TEST_MODE=true

# Optional integrations
ANTHROPIC_API_KEY=
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_PUBLIC_SITE_URL=https://kiraimobiliare.ro

# Collection of public prospect listings remains disabled unless explicitly approved
PROSPECTS_COLLECTION_APPROVED=false

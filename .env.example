# Public client configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase and account security
SUPABASE_SERVICE_ROLE_KEY=
REGISTRATION_ACCESS_CODE=
PORTAL_TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
# Minimum 16 random characters; used only to hash request IPs in the audit log.
AUDIT_IP_HASH_SALT=
# Minimum 32 random characters; hashes login identifiers/IPs and is never exposed client-side.
AUTH_SECURITY_HASH_SALT=

# Operational email and personal agent mailboxes (Resend, server-side).
# Verify kiraimobiliare.ro for sending + receiving and subscribe the webhook to:
# received, sent, delivered, bounced, failed and delivery_delayed.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Enable only after the end-to-end send/receive test succeeds.
MAIL_ONBOARDING_ENABLED=false

# Backup and recovery (server-side only)
# Base64 key of exactly 32 bytes, stored separately from the archives.
BACKUP_ENCRYPTION_KEY=
# Absolute directory outside the repository, on a separate/synchronized volume.
BACKUP_DIRECTORY=
# PostgreSQL connection string from Supabase > Connect.
SUPABASE_DB_URL=
KIRA_PG_TOOLS_IMAGE=postgres:17-alpine

# Storia / OLX
STORIA_CLIENT_ID=
STORIA_CLIENT_SECRET=
STORIA_API_KEY=
STORIA_WEBHOOK_SECRET=
STORIA_TEST_MODE=true

# Optional integrations
ANTHROPIC_API_KEY=
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_PUBLIC_SITE_URL=https://kiraimobiliare.ro

# Collection of public prospect listings remains disabled unless explicitly approved
PROSPECTS_COLLECTION_APPROVED=false
